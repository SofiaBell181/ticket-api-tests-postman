    {
      "name": "Create a ticket",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const dataResponse = pm.response.json();\r",
              "\r",
              "pm.globals.set(\"id_ticket\", dataResponse.id);\r",
              "\r",
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Check field title value\", function () {\r",
              "    pm.expect(dataResponse.title).to.equal(pm.iterationData.get(\"title\"))\r",
              "});\r",
              "\r",
              "pm.test(\"Check field description value\", function () {\r",
              "    pm.expect(dataResponse.description).to.equal(pm.iterationData.get(\"description\"))\r",
              "});\r",
              "\r",
              "pm.test(\"Check field due_date value\", function () {\r",
