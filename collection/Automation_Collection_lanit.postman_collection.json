        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const options = {\r",
              "        'method': 'POST',\r",
              "        'url': 'https://ft-sandbox.workbench.lanit.ru/api/tickets',\r",
              "        'header': {\r",
              "            'Content-Type': 'application/json'\r",
              "        },\r",
              "        body: JSON.stringify({\r",
              "            \"title\": \"title new tickets\",\r",
              "            \"description\": \"new description\",\r",
              "            \"queue\":  1,\r",
              "        })\r",
              "    };\r",
              "    \r",
              "try {\r",
              "    const response = await pm.sendRequest(options);\r",
              "    const dataSet = response.json();\r",
              "        pm.collectionVariables.set('titleTicket', dataSet.title);\r",
              "        pm.collectionVariables.set('idTicket', dataSet.id);\r",
              "        pm.collectionVariables.set('descriptionTicket', dataSet.description);\r",
              "        console.log(dataSet);\r",
              "} catch (err) {\r",
              "    console.error(err);\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
